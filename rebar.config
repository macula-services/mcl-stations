%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_stations.
%%
%% Live, filterable directory of macula stations: geo, health and direct-dial address, so clients never hand-maintain a station list
%%
%% Generated by `rebar3 new mcl_service'. The scaffold boots, joins the mesh
%% and answers /health; it does nothing else yet.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% Brings macula (QUIC NIF) transitively. No event store: the service
    %% exports no store_id/0. 0.29.1: a capability's ADVERTISE goes only to
    %% its serving station.
    {mcl_om, "~> 0.29.1"},
    %% Named for its floor: 12.5.1 carries the admission expiry fix (#37),
    %% without which a provider that has run for about two hours stops
    %% admitting callers. mcl_om alone would allow 12.2.
    {macula, ">= 12.5.1 and < 13.0.0"},
    %% The station read model is this service's own (mcl_om stopped bringing
    %% barrel_docdb in 0.27.0). barrel brings the erlang rocksdb binding; see
    %% the override below.
    {barrel_docdb, "~> 1.5"}
]}.

%% ⚠ ROCKSDB LINKS THE SYSTEM LIBRARY. The rocksdb binding's pre_hook would
%% otherwise compile the RocksDB it bundles, tens of minutes of CPU in every
%% CI run, image build and local test. With `-DWITH_SYSTEM_ROCKSDB=ON' it links
%% librocksdb 11.1.x instead, the release rocksdb 3.1.2 is written against,
%% which no distribution packages: build in macula-ci-otp-rocksdb and run on
%% macula-pq-runtime-rocksdb (both pinned by digest in lint.yml and the
%% Containerfile). Without the library the build stops at configure with
%% "Could not find RocksDB", on purpose. An override replaces the whole key,
%% so the binding's clean hooks are repeated.
{overrides, [
    {override, rocksdb, [
        {pre_hooks, [
            {clean, "rm -f priv/*.so"},
            {clean, "rm -rf _build/cmake"},
            {"(linux|darwin|solaris)", compile,
             "./do_cmake.sh -DWITH_SYSTEM_ROCKSDB=ON $ERLANG_ROCKSDB_OPTS"},
            {"(freebsd|netbsd|openbsd)", compile,
             "./do_cmake.sh -DWITH_SYSTEM_ROCKSDB=ON $ERLANG_ROCKSDB_OPTS"}
        ]}
    ]}
]}.

%% macula and barrel_docdb are called directly (DHT records, the read model);
%% listing them in the .app.src applications puts them in dialyzer's view.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

{relx, [
    {release, {mcl_stations, "0.1.0"}, [mcl_stations, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
